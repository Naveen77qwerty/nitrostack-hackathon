{
  "name": "my-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An enterprise AI platform that identifies repetitive employee workflows across multiple business tools and transforms them into intelligent automations using MCP",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "test:phase4": "tsc -p tsconfig.test.json && node --test --test-force-exit .test-dist/tests/phase4.test.js",
    "test:phase5": "npm run test:phase4",
    "test:phase6": "npm run test:phase4",
    "test:phase7": "tsc -p tsconfig.test.json && node --test --test-force-exit .test-dist/tests/phase7.test.js",
    "test:phase8": "tsc -p tsconfig.test.json && node --test --test-force-exit .test-dist/tests/phase8.test.js",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "@modelcontextprotocol/ext-apps": ">=0.1.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "Team4",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
